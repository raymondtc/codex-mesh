{
  "name": "codex-mesh",
  "version": "0.1.0",
  "description": "Connect a local Codex app-server to a Codex Mesh control plane",
  "type": "module",
  "license": "MIT",
  "bin": {
    "codex-mesh": "dist/index.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "git+https://github.com/raymondtc/codex-mesh.git" },
  "bugs": { "url": "https://github.com/raymondtc/codex-mesh/issues" },
  "homepage": "https://github.com/raymondtc/codex-mesh#readme",
  "keywords": ["codex", "openai", "remote", "agent", "mesh"],
  "dependencies": { "ws": "^8.18.3" },
  "devDependencies": { "@types/node": "^24.3.0", "@types/ws": "^8.18.1", "typescript": "^5.9.2" },
  "publishConfig": { "access": "public" }
}
