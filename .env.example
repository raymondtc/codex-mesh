# Required when listening beyond localhost. Use a long random value.
REMOTE_WEB_TOKEN=replace-with-a-long-random-token

# Local-only by default. Set 0.0.0.0 only behind HTTPS or a private overlay network.
HOST=127.0.0.1
PORT=8787

# Optional overrides.
# CODEX_BIN=/absolute/path/to/codex
# CODEX_CWD=/absolute/path/to/default/workspace
# CODEX_APP_SERVER_URL=unix:///absolute/path/to/app-server-control.sock
# Use stdio:// to force an isolated app-server instead of auto-detecting the local daemon.
