# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Required in production. Encrypts SSH private keys at rest. Generate separately:
# openssl rand -base64 32
SSH_KEY_ENCRYPTION_KEY=replace-with-an-independent-random-secret

# Public origin of the control plane. Use HTTPS outside local development.
BETTER_AUTH_URL=http://127.0.0.1:8787
TRUSTED_ORIGINS=http://127.0.0.1:8787,http://127.0.0.1:5173

# Local-only by default. Use 0.0.0.0 only behind HTTPS or a private network.
HOST=127.0.0.1
PORT=8787

# Optional reverse SSH relay. The relay port must be reachable by remote hosts.
# Production requires a persistent Ed25519 host key file.
RELAY_ENABLED=0
RELAY_HOST=0.0.0.0
RELAY_PORT=2222
# RELAY_PUBLIC_HOST=mesh.example.com
# RELAY_HOST_KEY_PATH=/run/secrets/codex-mesh-relay-ed25519

# Optional PostgreSQL connection. Without it, persistent PGlite is used.
# DATABASE_URL=postgresql://user:password@localhost:5432/codex_mesh
# CODEX_MESH_DATA_DIR=/var/lib/codex-mesh
# PGLITE_DIR=/var/lib/codex-mesh/database

# Optional development escape hatch. Remote hosts use SSH and run no Mesh agent.
CODEX_LOCAL_MACHINE=off

# Optional local Codex overrides.
# CODEX_BIN=/absolute/path/to/codex
# CODEX_CWD=/absolute/path/to/default/workspace
# CODEX_APP_SERVER_URL=unix:///absolute/path/to/app-server-control.sock
# Use stdio:// to force an isolated app-server instead of auto-detecting the daemon.
