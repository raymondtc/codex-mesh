[Unit]
Description=Codex Mesh outbound agent
Documentation=https://github.com/raymondtc/codex-mesh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=NODE_ENV=production
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/codex-mesh start
Restart=always
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true

[Install]
WantedBy=default.target
